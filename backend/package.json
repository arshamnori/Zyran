{
  "name": "zyran-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply zyran-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply zyran-db --remote",
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/http.js && node --check src/security.js"
  },
  "devDependencies": {
    "wrangler": "^4.42.0"
  }
}
